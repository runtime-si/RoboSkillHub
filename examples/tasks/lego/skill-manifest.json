  "skills": [
    {
      "skill_id": "lego.align_connection",
      "version": "0.1.0",
      "kind": "skill",
      "readiness": "unit-tested",
      "evidence_level": "unit_or_dryrun",
      "entrypoint": "roboskillhub.tasks.lego.skills:AlignConnection",
      "requires": [
        "cartesian_motion",
        "object_feedback",
        "object_pose_feedback",
        "pose_feedback",
        "stop"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "target",
          "held",
          "limits"
        ],
        "properties": {
          "connection_id": {
            "type": "string"
          },
          "target": {
            "$ref": "#/schemas/LegoMatingTarget"
          },
          "held": {
            "$ref": "#/schemas/HeldObject"
          },
          "build": {
            "type": "array",
            "items": {
              "$ref": "#/schemas/LegoMatingTarget"
            }
          },
          "limits": {
            "type": "object"
          },
          "close_axis": {
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "postcondition": {
        "name": "held_brick_aligned",
        "criterion": "fresh independent observation of the held brick, after the last move, within xy_tolerance_m and yaw_tolerance_deg of the hover pose"
      },
      "summary": "Non-contact pre-alignment of a held brick over its target studs with bounded correction from fresh independent observations of the brick.",
      "pure_entrypoint": "roboskillhub.tasks.lego.align:align_connection",
      "inputs": "connection_id, target (LegoMatingTarget), held (HeldObject), build[], limits{xy_tolerance_m, yaw_tolerance_deg, workspace_min_m, workspace_max_m, limits_source, preassembly_height_m?, max_corrections?, max_total_correction_m?, speed_m_s?, deadline_s?, max_obs_age_s?, support_required_fraction?}, close_axis?",
      "preconditions": [
        "held.valid and fresh",
        "interface match",
        "cell on the plate",
        "target cells free",
        "support under layer > 0",
        "jaw rows clear of the build",
        "unambiguous symmetric orientation",
        "hover inside workspace",
        "observer resolves the tolerance",
        "tolerance within the press's known capture",
        "mating_pose agrees with placement"
      ],
      "executable": false,
      "executable_note": "runs on any backend with object_pose_feedback; none declares it unprivileged today (Isaac only with privileged truth)"
    },
    {
      "skill_id": "lego.guarded_seat",
      "version": "0.1.0",
      "kind": "skill",
      "readiness": "unit-tested",
      "evidence_level": "unit_or_dryrun",
      "entrypoint": "roboskillhub.tasks.lego.skills:GuardedSeat",
      "requires": [
        "compliant_motion",
        "contact_force_feedback",
        "pose_feedback",
        "stop"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "alignment",
          "press_limits"
        ],
        "properties": {
          "connection_id": {
            "type": "string"
          },
          "alignment": {
            "type": "object"
          },
          "press_limits": {
            "type": "object"
          },
          "axis": {
            "type": "object"
          }
        }
      },
      "postcondition": {
        "name": "bounded_press_complete",
        "criterion": "stop confirmed, peak <= 1.25 x force_limit_N, contact at the stud tops; the pressed brick observed after the press within seat_depth_tolerance_m (default 0.35 stud height) of its seat and within verify's lateral/yaw/tilt bands; plus a force_threshold stop when the station declares an insertion-observable force signal; without a usable observation a force-observable station falls back to TCP travel. Connection NOT verified here"
      },
      "summary": "Bounded contact press along the engagement axis with a measured force signal; returns the contact trace and stop reason; operation_complete only.",
      "pure_entrypoint": "roboskillhub.tasks.lego.seat:guarded_seat",
      "inputs": "connection_id, alignment (align outputs), press_limits{max_travel_m, speed_m_s, timeout_s, force_limit_N, limits_source, hold_s?, torque_limit_Nm?}, axis?",
      "control_statement": "position-only press (move_pose / travel limit / tracking lag / joint effort) is NOT compliant force control and is not accepted by lego.guarded_seat",
      "needs_from_runtime": [
        "primitive guarded_press",
        "SkillContext.contact_description"
      ],
      "executable": false,
      "executable_note": "no backend declares contact_force_feedback + compliant_motion; the guarded_press primitive does not exist yet"
    },
    {
