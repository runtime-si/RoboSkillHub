            "type": "number"
          },
          "retreat_height_m": {
            "type": "number"
          },
          "speed_m_s": {
            "type": "number"
          }
        }
      },
      "postcondition": {
        "name": "released_and_retreated",
        "criterion": "set_gripper(release) measured holding=false, then the measured TCP rose at least half of retreat_height_m along the engagement axis"
      },
      "summary": "set_gripper(release) with measured holding=false, then a bounded retreat along the engagement axis; observes the brick before and after.",
      "inputs": "connection_id, object_id, press (seat outputs), open_width_m, retreat_height_m, speed_m_s?",
      "executable": false,
      "executable_note": "retreat path is backend-defined (no linear_cartesian_motion)"
    },
    {
      "skill_id": "lego.verify_connection",
      "version": "0.1.0",
      "kind": "skill",
      "readiness": "unit-tested",
      "evidence_level": "unit_or_dryrun",
      "entrypoint": "roboskillhub.tasks.lego.skills:VerifyConnection",
      "requires": [
        "object_feedback",
        "object_pose_feedback"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "target",
          "executor_id",
          "release"
        ],
        "properties": {
          "connection_id": {
            "type": "string"
          },
          "target": {
            "$ref": "#/schemas/LegoMatingTarget"
          },
          "build": {
            "type": "array",
            "items": {
              "$ref": "#/schemas/LegoMatingTarget"
            }
          },
          "executor_id": {
            "type": "string"
          },
          "release": {
            "type": "object"
          },
          "pre_release_observation": {
            "type": [
              "object",
              "null"
            ]
          },
          "must_observe_neighbours": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "window": {
            "type": "object"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/schemas/Observation"
            }
          }
        }
      },
      "postcondition": {
        "name": "geometric_seating",
        "criterion": "after release and retreat, independent observations over window_s show the brick on its cell within lateral/yaw/tilt/height bands (stud geometry + 2 sigma), stable, and the listed neighbours undisturbed; no retention test"
      },
      "summary": "Executor-independent verdict satisfied/violated/unknown on stud cell, yaw, engagement height, tilt, post-release stability and the surrounding build.",
      "pure_entrypoint": "roboskillhub.tasks.lego.verify:verify_connection",
      "inputs": "connection_id, target, build[], executor_id, release (release outputs), pre_release_observation?, must_observe_neighbours?, window?, observations? (offline)",
      "verdict_to_status": {
        "satisfied": "succeeded",
        "violated": "failed",
        "unknown": "unverified"
      },
      "claim_on_success": "geometric_seating_verified (never retention force or interlock)",
      "executable": false,
      "executable_note": "meaningful only with an observer whose 2 sigma is under 0.35 stud heights (0.6 mm LEGO, 1.6 mm DUPLO); the pure function runs offline"
    }
  ],
