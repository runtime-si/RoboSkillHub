{
  "skill": "disassembling-a-brick-by-twist-lever",
  "inputs": {"brick_position": "Vec3", "brick_yaw_deg": "float"},
  "outputs": {
    "strategy": {"$ref": "lever.strategy"},
    "holding": {"$ref": "lever.holding"},
    "top_height_change": {"$ref": "lever.top_height_change"}
  },
  "nodes": {
    "lever": {
      "type": "script",
      "script": "scripts/disassemble_brick.py",
      "inputs": {
        "brick_position": {"$ref": "in.brick_position"},
        "brick_yaw_deg": {"$ref": "in.brick_yaw_deg"},
        "system": "duplo",
        "strategy": "lever",
        "fallbacks": "straight"
      }
    }
  },
  "edges": [["START", "lever"], ["lever", "END"]],
  "exit": {
    "router_field": "route",
    "success_values": ["removed", "stuck", "slipped", "neighbour_lifted", "missed", "unverified"]
  },
  "on_error": "unreachable"
}
