{
  "skill": "carrying-over-an-obstacle-with-a-leaning-hand",
  "inputs": {
    "container_obb": "OrientedBoundingBox"
  },
  "outputs": {
    "release_position": {"$ref": "carry.release_position"},
    "drop_point": {"$ref": "carry.drop_point"},
    "carried_z": {"$ref": "carry.carried_z"},
    "inside_m": {"$ref": "carry.inside_m"}
  },
  "nodes": {
    "carry": {
      "type": "script",
      "script": "scripts/carry_and_release.py",
