{
  "skill": "locating-a-hole-lattice-by-wide-search",
  "inputs": {"prior": "Any"},
  "outputs": {
    "pose": {"$ref": "locate.pose"},
    "nodes": {"$ref": "locate.nodes"},
    "matched": {"$ref": "locate.matched"}
  },
  "nodes": {
    "locate": {
      "type": "script",
