{
  "skill": "locating-a-container-from-the-wrist-camera",
  "inputs": {
    "container_obb": "OrientedBoundingBox"
  },
  "outputs": {
    "located_obb": {"$ref": "locate.located_obb"},
    "shift": {"$ref": "locate.shift"},
    "aim_point": {"$ref": "locate.aim_point"}
  },
  "nodes": {
    "locate": {
      "type": "script",
      "script": "scripts/locate_container.py",
      "inputs": {
        "container_obb": {"$ref": "in.container_obb"}
      }
    }
  },
  "edges": [["START", "locate"], ["locate", "END"]],
  "exit": {"router_field": "route", "success_values": ["located"]},
  "on_error": "unreachable"
}
