{
  "skill": "pipelining-perception-and-planning-ahead-of-motion",
  "inputs": {"tasks": "string", "pick_place_skill": "string"},
  "outputs": {"makespan_s": {"$ref": "run.makespan_s"}, "idle_s": {"$ref": "run.idle_s"}, "tasks": {"$ref": "run.tasks"}},
  "nodes": {
    "run": {
      "type": "script",
